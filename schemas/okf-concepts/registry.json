{
  "version": "0.3.0",
  "plugin": "news-digest",
  "types": [
    {
      "type": "NewsItem",
      "folder": "news-items",
      "description": "Single news item"
    },
    {
      "type": "Source",
      "folder": "sources",
      "description": "Publication or feed"
    },
    {
      "type": "Digest",
      "folder": "digests",
      "description": "Scheduled rollup (morning / afternoon)"
    },
    {
      "type": "SignalStrength",
      "folder": "signal-strengths",
      "description": "High / medium / low importance"
    },
    {
      "type": "Topic",
      "folder": "topics",
      "description": "Normalized topic tag"
    },
    {
      "type": "Trend",
      "folder": "trends",
      "description": "Multi-item pattern"
    },
    {
      "type": "CompanyMention",
      "folder": "company-mentions",
      "description": "Company referenced in news"
    },
    {
      "type": "ProductLaunch",
      "folder": "product-launchs",
      "description": "Launch event"
    },
    {
      "type": "ResearchPaper",
      "folder": "research-papers",
      "description": "Paper worth tracking"
    },
    {
      "type": "OpinionPiece",
      "folder": "opinion-pieces",
      "description": "Commentary item"
    },
    {
      "type": "FollowUpCandidate",
      "folder": "follow-up-candidates",
      "description": "Item that should become an article"
    },
    {
      "type": "SourceCredibility",
      "folder": "source-credibilities",
      "description": "Trust note on a source"
    },
    {
      "type": "TimestampedEvent",
      "folder": "timestamped-events",
      "description": "Dated industry event"
    }
  ]
}
